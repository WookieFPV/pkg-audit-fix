{
  "name": "pkg-audit-fix",
  "version": "0.3.0",
  "description": "Audit dependencies and run native fix flows across pnpm, npm, yarn, and bun.",
  "type": "module",
  "bin": {
    "pkg-audit-fix": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "package:check": "publint && npm pack --dry-run",
    "ci": "biome check . && tsc --noEmit && vitest run test && tsdown && publint"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "audit",
    "audit-fix",
    "security",
    "vulnerability",
    "remediation",
    "dependencies",
    "pnpm",
    "npm",
    "yarn",
    "bun",
    "cli"
  ],
  "author": {
    "name": "WookieFPV (Lukas Müller)",
    "url": "https://github.com/WookieFPV"
  },
  "license": "MIT",
  "homepage": "https://github.com/WookieFPV/pkg-audit-fix#readme",
  "bugs": {
    "url": "https://github.com/WookieFPV/pkg-audit-fix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WookieFPV/pkg-audit-fix.git"
  },
  "dependencies": {
    "picospinner": "3.0.0",
    "package-manager-detector": "1.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.5.0",
    "@changesets/cli": "2.31.0",
    "@types/node": "26.0.0",
    "bun-types": "1.3.14",
    "lefthook": "2.1.9",
    "publint": "0.3.21",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
